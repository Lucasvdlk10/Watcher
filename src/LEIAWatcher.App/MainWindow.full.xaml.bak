<Window x:Class="LEIAWatcher.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LEIAWatcher.App"><Grid Background="{StaticResource AppBackground}"><Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Grid Grid.Column="0" Background="{StaticResource SidebarBackground}"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Spacing="12" Margin="21,26,0,12" VerticalAlignment="Center"><Image Source="ms-appx:///Assets/Brand/LEIA_Watcher_Logo_512.png" Width="42" Height="42"/><StackPanel VerticalAlignment="Center"><TextBlock Text="LEIA WATCHER" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="CONTROLE LOCAL" FontSize="10" CharacterSpacing="70" Foreground="{StaticResource TextMuted}"/></StackPanel></StackPanel>
  <StackPanel Grid.Row="1" Spacing="4" Margin="10,12"><TextBlock Text="WORKSPACE" Style="{StaticResource Caption}" Margin="17,5,0,13"/><Button Style="{StaticResource NavButton}" Tag="overview" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE80F;" FontSize="16"/><TextBlock Text="Visão geral" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource NavButton}" Tag="folders" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B7;" FontSize="16"/><TextBlock Text="Pastas" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource NavButton}" Tag="rules" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16"/><TextBlock Text="Regras" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource NavButton}" Tag="files" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="16"/><TextBlock Text="Arquivos" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource NavButton}" Tag="history" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;" FontSize="16"/><TextBlock Text="Histórico" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource NavButton}" Tag="hermes" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F4;" FontSize="16"/><TextBlock Text="Integração Hermes" VerticalAlignment="Center"/></StackPanel></Button><Rectangle Height="1" Fill="{StaticResource StrokeSubtle}" Margin="13,18"/><Button Style="{StaticResource NavButton}" Tag="settings" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16"/><TextBlock Text="Configurações" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
  <Border Grid.Row="2" Background="{StaticResource SurfacePrimary}" BorderThickness="1,0,0,0" BorderBrush="{StaticResource StrokeSubtle}" Padding="20,17"><StackPanel Spacing="4"><TextBlock Text="WATCHER 4.0" Foreground="{StaticResource TextSecondary}" FontSize="11"/><TextBlock Text="●  Sem tokens · Sem nuvem" Foreground="{StaticResource Success}" FontSize="11"/></StackPanel></Border>
 </Grid>
 <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,0,0,1" Padding="26,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GlobalSearch" Width="280" Height="37" HorizontalAlignment="Left" VerticalAlignment="Center" PlaceholderText="Buscar arquivos (Ctrl+K)" TextChanged="SearchChanged" AutomationProperties.Name="Busca global"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource Success}"/><TextBlock Text="{Binding ConnectionLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/><Button Content="↻" Width="36" Height="36" Click="RefreshClicked" ToolTipService.ToolTip="Atualizar dados"/></StackPanel></Grid></Border>
  <Frame x:Name="ContentFrame" Grid.Row="1" Background="{StaticResource AppBackground}"/>
  <Border Grid.Row="2" Background="{StaticResource SidebarBackground}" Padding="17,0"><TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
 </Grid>
 </Grid></Window>