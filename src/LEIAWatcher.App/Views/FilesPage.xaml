<Page x:Class="LEIAWatcher.App.Views.FilesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LEIAWatcher.App.Views" Background="{StaticResource AppBackground}"><Grid Padding="26" RowSpacing="13"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Spacing="5"><TextBlock Text="Catálogo de arquivos" Style="{StaticResource PageTitle}"/><TextBlock Text="Inventário atual + histórico anterior, sem abrir arquivos nem expor conteúdo." Style="{StaticResource Caption}"/></StackPanel>
<Border Grid.Row="1" Style="{StaticResource PanelCard}"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchFiles" PlaceholderText="Pesquisar por nome ou caminho" Text="{Binding Search,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Column="1" x:Name="ExtensionFilter" PlaceholderText="Extensão (.pdf)" TextChanged="FilterChanged"/><ComboBox Grid.Column="2" x:Name="StatusFilter" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="Todos"/><ComboBoxItem Content="LEGACY"/><ComboBoxItem Content="PRESENT"/></ComboBox><ComboBox Grid.Column="3" x:Name="OriginFilter" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="Todos"/><ComboBoxItem Content="Atuais"/><ComboBoxItem Content="Históricos"/></ComboBox><Button Grid.Column="4" Content="Atualizar" Command="{Binding LoadFilesCommand}"/></Grid></Border>
<Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="4"><ListView ItemsSource="{Binding Files}" SelectionMode="None"><ListView.Header><Grid Padding="12" ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="Nome" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="Caminho" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="Extensão" Style="{StaticResource Caption}"/><TextBlock Grid.Column="3" Text="Origem" Style="{StaticResource Caption}"/></Grid></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="12,7" ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Extension}"/><TextBlock Grid.Column="3" Text="{Binding Source}" Foreground="{StaticResource AccentCyan}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FilePageLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/><Button Grid.Column="1" Content="Anterior" Command="{Binding PreviousFilesCommand}" Margin="0,0,8,0"/><Button Grid.Column="2" Content="Próxima" Command="{Binding NextFilesCommand}"/></Grid></Grid></Page>