<Page x:Class="LEIAWatcher.App.Views.RulesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LEIAWatcher.App.Views" Background="{StaticResource AppBackground}"><ScrollViewer><StackPanel Padding="26" Spacing="14"><StackPanel Spacing="6"><TextBlock Text="Editor de regras" Style="{StaticResource PageTitle}"/><TextBlock Text="A alteração é validada pelo motor Python e gravada com backup transacional." Style="{StaticResource Caption}"/></StackPanel>
<Border Style="{StaticResource PanelCard}"><StackPanel Spacing="12"><TextBlock Text="Pasta de destino" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding RootChoices}" SelectedItem="{Binding SelectedRoot,Mode=TwoWay}" DisplayMemberPath="Name" MinWidth="260" HorizontalAlignment="Left"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Header="Hierarquia (type,date,keyword)" Text="{Binding RuleSteps,Mode=TwoWay}"/><TextBox Grid.Column="1" Header="Pasta padrão" Text="{Binding RulesFallback,Mode=TwoWay}"/></Grid></StackPanel></Border>
<Border Style="{StaticResource PanelCard}"><StackPanel Spacing="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Regras do motor" Style="{StaticResource SectionTitle}"/><Button Grid.Column="1" Content="+ Nova regra" Click="AddRule"/></Grid>
<Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="Tipo" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="Extensões / palavras-chave" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="Destino" Style="{StaticResource Caption}"/><TextBlock Grid.Column="3" Text="Ativa" Style="{StaticResource Caption}"/></Grid>
<ListView ItemsSource="{Binding Rules}" SelectionMode="None" Background="Transparent" MaxHeight="365"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{Binding Kind,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="type"/><TextBox Grid.Column="1" Text="{Binding Values,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText=".pdf, .docx"/><TextBox Grid.Column="2" Text="{Binding Target,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Grid.Column="3" IsChecked="{Binding Enabled,Mode=TwoWay}" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Simular regras atuais" Command="{Binding PreviewRulesCommand}"/><Button Content="Validar sem aplicar" Command="{Binding ValidateRulesCommand}"/><Button Content="Aplicar regras" Style="{StaticResource PrimaryAction}" Command="{Binding SaveRulesCommand}"/></StackPanel><TextBlock Text="Pré-visualização de movimentações: use a varredura em modo TRACK_ONLY antes de ativar." Style="{StaticResource Caption}"/></StackPanel></Border></StackPanel></ScrollViewer></Page>