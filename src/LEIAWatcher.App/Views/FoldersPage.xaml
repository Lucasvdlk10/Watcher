<Page x:Class="LEIAWatcher.App.Views.FoldersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LEIAWatcher.App.Views" Background="{StaticResource AppBackground}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Padding="26" Spacing="18"><StackPanel Spacing="6"><TextBlock Text="Pastas monitoradas" Style="{StaticResource PageTitle}"/><TextBlock Text="Pastas reais conectadas ao motor local; nenhuma movimentação é executada pela interface." Style="{StaticResource Caption}"/></StackPanel>
<Border Style="{StaticResource PanelCard}"><StackPanel Spacing="10"><TextBlock Text="Adicionar pasta" Style="{StaticResource SectionTitle}"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox PlaceholderText="Caminho da pasta" Text="{Binding NewFolderPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Diretório a monitorar"/><Button Grid.Column="1" Content="Selecionar diretório" Click="PickFolder"/></Grid><TextBox Header="Nome (opcional)" Text="{Binding NewFolderName,Mode=TwoWay}"/><TextBlock Text="Modo de monitoramento" Style="{StaticResource Caption}"/><ComboBox x:Name="ModePicker" SelectedIndex="0" SelectionChanged="ModeChanged" MinWidth="230"><ComboBoxItem Content="Rastreio · sem movimentações" Tag="TRACK_ONLY"/><ComboBoxItem Content="Organização" Tag="ORGANIZE"/></ComboBox>
<StackPanel Spacing="9" Visibility="{Binding IsOrganize,Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="Estratégia de organização" Style="{StaticResource Caption}"/><ComboBox x:Name="ProfilePicker" SelectedIndex="0" SelectionChanged="ProfileChanged" MinWidth="250"><ComboBoxItem Content="Por tipo" Tag="TYPE"/><ComboBoxItem Content="Por tipo e data" Tag="TYPE_DATE"/><ComboBoxItem Content="Por data" Tag="DATE"/></ComboBox><CheckBox Content="Organizar pastas avulsas" IsChecked="{Binding LooseFolders,Mode=TwoWay}"/><CheckBox Content="Ativar monitoramento após aplicar" IsChecked="{Binding ActivateFolder,Mode=TwoWay}"/><CheckBox Content="Confirmo que a ativação pode movimentar arquivos" IsChecked="{Binding ConfirmMovements,Mode=TwoWay}"/></StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Aplicar pasta" Style="{StaticResource PrimaryAction}" Command="{Binding AddRootCommand}" MinWidth="150"/></StackPanel></StackPanel></Border>
<TextBlock Text="Pastas existentes" Style="{StaticResource SectionTitle}"/><ListView ItemsSource="{Binding WatchedRoots}" SelectionMode="None" Background="Transparent"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelCard}" Margin="0,0,0,8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Mode}" VerticalAlignment="Center" Foreground="{StaticResource AccentBlue}"/><TextBlock Grid.Column="2" Text="{Binding Health}" VerticalAlignment="Center"/><Button Grid.Column="3" Content="Pausar" Tag="{Binding Id}" Click="PauseClicked" MinWidth="65"/><Button Grid.Column="4" Content="Retomar" Tag="{Binding Id}" Click="ResumeClicked" MinWidth="75"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></ScrollViewer></Page>