<Page x:Class="LEIAWatcher.App.Views.OverviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LEIAWatcher.App.Views" Background="{StaticResource AppBackground}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Padding="26,19,26,14" RowSpacing="16" MinHeight="700">
<Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="104"/><RowDefinition Height="280"/><RowDefinition Height="96"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Spacing="6"><TextBlock Text="CONTROLE LOCAL  ·  SEM TOKENS" Foreground="{StaticResource AccentCyan}" CharacterSpacing="100" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Seus arquivos. Sob controle." Style="{StaticResource Display}"/><TextBlock Text="Visibilidade em tempo real, organização segura e histórico auditável." Style="{StaticResource Caption}"/></StackPanel>
<Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource PanelCard}"><StackPanel Spacing="8"><TextBlock Text="CATÁLOGO UNIFICADO" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TotalFiles}" Style="{StaticResource NumericMetric}"/><TextBlock Text="Atuais + históricos" Foreground="{StaticResource AccentBlue}" FontSize="11"/></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource PanelCard}"><StackPanel Spacing="8"><TextBlock Text="ARQUIVOS ATUAIS" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CurrentFiles}" Style="{StaticResource NumericMetric}"/><TextBlock Text="Inventário monitorado" Style="{StaticResource Caption}"/></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource PanelCard}"><StackPanel Spacing="8"><TextBlock Text="HISTÓRICO ANTERIOR" Style="{StaticResource Caption}"/><TextBlock Text="{Binding LegacyFiles}" Style="{StaticResource NumericMetric}"/><TextBlock Text="Importados sem alteração" Foreground="{StaticResource AccentViolet}" FontSize="11"/></StackPanel></Border>
<Border Grid.Column="3" Style="{StaticResource PanelCard}"><StackPanel Spacing="8"><TextBlock Text="OPERAÇÕES PENDENTES" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Pending}" Style="{StaticResource NumericMetric}"/><TextBlock Text="Monitoramento local" Foreground="{StaticResource Success}" FontSize="11"/></StackPanel></Border></Grid>
<Grid Grid.Row="2" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.10*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource PanelCard}"><Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Atividade da última semana" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"/>
<ItemsRepeater Grid.Row="1" ItemsSource="{Binding Activity}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="ActivitySizeChanged"><ItemsRepeater.Layout><UniformGridLayout x:Name="ActivityLayout" Orientation="Horizontal" MaximumRowsOrColumns="7" MinItemWidth="44" MinItemHeight="116"/></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate><Grid Padding="4,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Spacing="6"><TextBlock Text="{Binding Count}" Foreground="{StaticResource TextSecondary}" FontSize="10" HorizontalAlignment="Center"/><Border MinWidth="18" MaxWidth="44" HorizontalAlignment="Stretch" Height="{Binding Height}" Background="{StaticResource AccentBlue}" Opacity="0.78" CornerRadius="4,4,1,1" VerticalAlignment="Bottom"/><TextBlock Text="{Binding Day}" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel></Grid></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
<TextBlock Grid.Row="2" Text="Dados obtidos do IPC local. Sem simulações." Style="{StaticResource Caption}"/></Grid></Border>
<Border Grid.Column="1" Style="{StaticResource PanelCard}"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Atividade recente" Style="{StaticResource SectionTitle}"/><ListView Grid.Row="1" ItemsSource="{Binding Recent}" BorderThickness="0" Background="Transparent" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Disabled"><ListView.ItemTemplate><DataTemplate><Grid Padding="2,5" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="{Binding Event}" FontSize="12" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextMuted}" MaxLines="1" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Outcome}" Foreground="{StaticResource AccentCyan}" FontSize="11"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border></Grid>
<Border Grid.Row="3" Style="{StaticResource PanelCard}"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="6"><TextBlock Text="Ações rápidas" Style="{StaticResource SectionTitle}"/><TextBlock Text="Sem ações diretas no sistema de arquivos." Style="{StaticResource Caption}"/></StackPanel><Button Grid.Column="1" Content="Pastas" Click="OpenFolders" MinWidth="100"/><Button Grid.Column="2" Content="Catálogo" Click="OpenFiles" MinWidth="100"/><Button Grid.Column="3" Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryAction}" MinWidth="110"/></Grid></Border>
</Grid></ScrollViewer></Page>